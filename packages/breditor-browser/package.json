{
  "name": "@breditor/browser",
  "version": "0.2.1",
  "description": "Framework-neutral browser runtime for the Breditor rich-text editor",
  "keywords": [
    "rich-text-editor",
    "contenteditable",
    "webassembly",
    "rust"
  ],
  "author": "Breditor contributors",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js",
      "default": "./dist/advanced.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "parse5": "8.0.1"
  },
  "peerDependencies": {
    "@breditor/wasm": "0.2.1"
  },
  "peerDependenciesMeta": {
    "@breditor/wasm": {
      "optional": true
    }
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package.mjs",
    "build": "node ../../scripts/check-package-licenses.mjs && node ../../scripts/check-browser-wasm-package-pair.mjs && npm run clean && tsc -p tsconfig.json --declaration false --removeComments && tsc -p tsconfig.json --emitDeclarationOnly",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  }
}
