  "contract": {
    "formats": [
      "breditor/shared-session-backup V1",
      "breditor/shared-paired-session-backup V1"
    ],
    "capture": "Point-in-time exact accepted native history; optional paired comments, local versions and nonsecret progress; async SHA-256 afterward. No flush, action or relay receipt.",
    "identity": "Caller explicitly selects profile/language/history/range/selection/search and review/relay/reviewed policy. A file cannot infer an upgrade or authority.",
    "authority": "host-reacquired is host acknowledgement, not authentication/fencing. Web Locks exclude same-origin clones; cross-device/server reconciliation remains host work.",
    "restore": "Closed bounded checksum/identity guards, leased native replay, canonical byte equality and insert-only IDB add with transaction-complete acknowledgement. Never overwrite/put, visible-AST fallback or history normalization.",
    "limits": {
      "documentTransportMiB": 33,
      "checkpointMiB": 16,
      "pairedTransportMiB": 65,
      "pairedRecordMiB": 32
    },
    "repair": "Install versionchange fence immediately after DB opening, including the awaited native factory window. Close/unblock upgrade, reject/free unpublished native owner and release leases. Live sessions retain their existing retired readable recovery behavior.",
    "unchanged": "No Rust/ABI/schema/model/journal/operation, existing durable-family, ordinary startup default, dependency or version change."
  },
