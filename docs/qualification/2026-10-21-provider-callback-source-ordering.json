    "matrix": [
      "native log / Verified",
      "raster manifest / Verified",
      "native log / missing-byte Pending",
      "raster manifest / missing-byte Pending"
    ],
    "before": "All four baseline scenarios first establish successful unchanged source coverage, then fail the expected refusal assertion after a final successful provider callback appends and syncs its exclusively owned source file.",
    "after": "The identical four assertions pass: source changes refuse before returning coverage and all changed bytes remain exact. Test source SHA-256 is unchanged across before/after.",
    "independentCaller": "The unchanged separately compiled public Rust caller flips both native-log returns from accepted to immediate refusal. Its source hashes and both before/after binaries are retained. The historical subsequentCheckRefused field is not counted as a newly executed after-fix check."
  },
  "guarantees": [
    "No caller-visible readiness is published after an unchecked final provider callback.",
    "Actual native/raster source changes cause refusal, not missing-data success, metadata retargeting, cleanup or repair.",
    "Normal Ready/Pending mapping and immutable content-ID behavior remain covered by the complete41-case public server recovery suite, including existing decoder/provider/credential and lifetime cases.",
    "Both candidate profiles require the four focused regressions in addition to full native/provider/recovery checks.",
    "Fresh native fixtures and unchanged source/installed mixed recovery assertions retain all180 original files/records/upload comparisons, future histories and writable-generation-author conformance."
  ],
  "remaining": [
    "Native A/B/C ancestry and SDK client operation parents still need combined ownership integration, provider/client-outbox closure, independent comment-generation session support and historic-copy disposition.",
