    "api": [
      "RichAssetStore.exportBackup({signal?})",
      "RichAssetStore.restoreBackup(name, blob, {uploadState:\"preserve\", signal?, limits?, onChange?})"
    ],
    "format": "breditor/raster-asset-archive V1",
    "scope": "Whole asset store, including bytes no longer referenced by visible content. No implicit pruning or per-room filter.",
    "capture": "Single readonly IndexedDB snapshot of exact raster payloads, metadata, queue states, attempts and cancellation epochs, followed by ordinary decode/SHA admission and canonical binary framing. No automatic flush, action or observer notification.",
    "restore": "Complete archive admission before opening a destination; empty-count/zero-counter compare, all add requests and budget update in one write transaction. No clear, merge or overwrite. Concurrent nonempty restores have one winner.",
    "authority": "Opaque receipts retain exact JS code units; preserving uploaded state does not authenticate a receipt or provide new provider credentials. Network remains explicitly host-triggered.",
    "limits": {
      "headerMiB": 16,
      "payloadMiB": 100,
      "fileMiB": 10,
      "prefixBytes": 21,
      "maximumFramedBytes": 121634837
    },
    "unchanged": "Rust/ABI/schema/model/journal meanings, existing asset schema/defaults and uploader receipt contract. No dependency or package-version changes."
