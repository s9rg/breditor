{
  "name": "breditor-workspace",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "demo:lists": "vite --config vite.lists.config.ts --port 4187 --strictPort",
    "demo:shared:network": "node scripts/demo-shared-relay.mjs",
    "build:demo:lists": "vite build --config vite.lists.config.ts",
    "test:demo:lists": "playwright test --config playwright.lists.config.ts",
    "typecheck:demo:lists": "tsc -p examples/lists/tsconfig.json && tsc -p tests/lists/tsconfig.json",
    "test:lists:experimental": "node scripts/build-experimental-flat-list.mjs",
    "test:lists:packages": "node scripts/check-experimental-flat-list-packages.mjs",
    "build:lists:opt-in": "node scripts/build-opt-in-flat-list-package.mjs",
    "test:lists:opt-in": "node scripts/check-opt-in-flat-list-package.mjs",
    "demo:lists:opt-in": "vite --config vite.lists-opt-in.config.mjs --port 4198 --strictPort",
    "test:demo:lists:opt-in": "playwright test -c playwright.lists-opt-in.config.ts",
    "test:lists:performance": "node scripts/measure-flat-list-performance.mjs",
    "measure:lists:size": "node scripts/measure-opt-in-flat-list-size.mjs",
    "demo:headings": "vite --config vite.headings.config.ts --port 4186 --strictPort",
    "build:demo:headings": "vite build --config vite.headings.config.ts",
    "test:demo:headings": "playwright test --config playwright.headings.config.ts",
    "test:headings:experimental": "node scripts/build-experimental-heading.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:candidate": "node scripts/verify-candidate.mjs",
    "verify:candidate:functional": "node scripts/verify-candidate.mjs --functional",
    "test:collaboration:native-joint-source": "node --test --test-concurrency=1 scripts/native-actor-durable-close.test.mjs scripts/native-actor-escrow.test.mjs scripts/native-actor-construction.test.mjs scripts/native-actor-cohort.test.mjs scripts/native-actor-retirement.test.mjs scripts/native-actor-transfer-intrinsics.test.mjs scripts/independent-source-release-retry.test.mjs scripts/native-joint-source-session.test.mjs scripts/native-joint-source-retry.test.mjs scripts/native-joint-source-metadata.test.mjs scripts/selected-delivery-startup-failure.test.mjs",
    "test:collaboration:native-joint-source:installed": "node scripts/check-native-joint-source-installed.mjs",
    "test:collaboration:native-joint-source:unknown": "node --test --test-concurrency=1 scripts/native-joint-source-metadata.test.mjs scripts/native-joint-source-unknown-native.test.mjs",
    "test:collaboration:native-joint-source:unknown:installed": "node scripts/check-native-joint-source-installed.mjs --native-unknown",
    "test:collaboration:metadata-continuation": "node scripts/check-metadata-continuation-source.mjs",
    "test:collaboration:metadata-continuation:installed": "node scripts/check-metadata-continuation-installed.mjs",
    "build:collaboration:native-publication:fixture": "node scripts/build-sdk-native-publication.mjs",
    "test:collaboration:native-publication": "node scripts/check-sdk-native-publication-source.mjs",
    "test:collaboration:native-publication:installed": "node scripts/check-sdk-native-publication-installed.mjs",
    "audit:v1": "node scripts/check-v1-readiness.mjs",
    "check:v1": "node scripts/check-v1-readiness.mjs --require-ready",
    "clean": "npm run clean --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "demo": "npm run build && npm run dev --workspace @breditor/example-react",
    "demo:clipboard": "npm run build && vite --config vite.browser.config.ts --host 127.0.0.1 --port 4185 --strictPort",
    "check:wasm-package": "npm run check --workspace @breditor/wasm",
    "check:size": "npm run build && node scripts/check-size-budgets.mjs",
    "smoke:packages": "./scripts/smoke-npm-packages.sh",
    "test": "npm run test --workspaces --if-present && npm run test:diagnostics && npm run test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:diagnostics": "vitest run --config vitest.diagnostics.config.ts",
    "test:startup:diagnostics": "npm run build && vite build --config vite.startup-diagnostics.config.ts && playwright test -c playwright.startup-diagnostics.config.ts --project=webkit",
    "test:property:diagnostics": "npm run build && vite build --config vite.property-isolation.config.ts && playwright test -c playwright.property-isolation.config.ts --project=webkit",
    "test:number:diagnostics": "vite build --config vite.number-transport.config.ts && playwright test -c playwright.number-transport.config.ts --project=webkit",
    "test:number:candidate": "npm run build && vite build --config vite.numeric-normalization.config.ts && playwright test -c playwright.numeric-normalization.config.ts --project=webkit",
    "demo:number:diagnostics": "node scripts/serve-number-repro.mjs",
    "test:browser": "npm run build && playwright test",
    "test:selection:stress": "npm run build && playwright test -c playwright.selection-stress.config.ts --project=webkit",
    "test:selection:stress:production": "npm run build && vite build --config vite.selection-stress.config.ts && playwright test -c playwright.selection-production-stress.config.ts --project=webkit",
    "test:demo": "npm run build && playwright test -c playwright.demo.config.ts",
    "test:demo:stress": "npm run build && playwright test -c playwright.demo-stress.config.ts --project=webkit",
    "test:clipboard:stress": "npm run build && playwright test -c playwright.clipboard-stress.config.ts --project=webkit",
    "typecheck:browser": "tsc -p tests/browser/tsconfig.json --noEmit",
    "typecheck:demo": "tsc -p tests/demo/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:generated-sdk": "node scripts/check-generated-package-output.mjs",
    "test:collaboration:metadata-evidence": "node --test --test-concurrency=1 scripts/metadata-continuation-evidence-admission.test.mjs scripts/metadata-continuation-evidence-native.test.mjs",
    "test:collaboration:metadata-evidence:installed": "node scripts/check-metadata-evidence-installed.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "fake-indexeddb": "6.2.6",
    "jsdom": "29.1.1",
    "playwright-core": "1.62.1",
    "rolldown": "1.2.7",
    "typescript": "7.0.2",
    "undici": "7.29.1",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
