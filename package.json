{
  "name": "breditor-workspace",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "clean": "npm run clean --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check:wasm-package": "npm run check --workspace @breditor/wasm",
    "smoke:packages": "./scripts/smoke-npm-packages.sh",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
